{
  "name": "relay-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check:types": "tsc -b --pretty false",
    "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "check:rust-coverage": "cargo +nightly llvm-cov --manifest-path src-tauri/Cargo.toml --all-features --workspace --ignore-filename-regex 'src/main.rs' --fail-under-lines 90",
    "check:secrets": "node tools/secret-scan.mjs",
    "check:licenses": "node tools/license-check.mjs",
    "check:dependencies": "npm audit --audit-level=high && npm run check:licenses && cargo deny --manifest-path src-tauri/Cargo.toml check",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:component": "vitest run src",
    "test:e2e": "playwright test",
    "test:live-rest": "vitest run src/test/liveRest/liveRestAcceptance.test.ts",
    "verify": "npm run check:types && npm run lint && npm run test:coverage && npm run build",
    "verify:release": "npm run verify && npm run test:component && npm run check:rust && npm run check:rust-coverage && cargo test --manifest-path src-tauri/Cargo.toml && npm run test:e2e && npm run check:secrets && npm run check:dependencies"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.9"
  }
}
